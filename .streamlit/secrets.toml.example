# Streamlit secrets example configuration for GeminiUsageDashboard
# In local development: copy this to .streamlit/secrets.toml (NEVER commit secrets.toml)
# In Streamlit Community Cloud: paste these key-values into the App Settings > Secrets

MONITOR_API_URL = "https://your-monitor-api.example.com"
MONITOR_READ_TOKEN = "replace-me"
DASHBOARD_PASSWORD = "replace-me"
